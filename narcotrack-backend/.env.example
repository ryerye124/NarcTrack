# ============================================================
# NarcTrack API — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to GitHub
# ============================================================

# PostgreSQL — from Supabase: Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-very-long-random-string-at-least-64-chars

# Session — generate same way as JWT_SECRET
SESSION_SECRET=replace-with-another-very-long-random-string

# Google OAuth — from console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# URLs
API_URL=https://narcotrack-api.railway.app        # Your Railway deploy URL
FRONTEND_URL=https://narcotrack.vercel.app         # Your Vercel deploy URL

# Sysadmin bootstrap password — used ONLY on first startup if no sysadmin exists
# Change immediately after first login. Remove or leave blank to disable auto-seed.
SYSADMIN_INITIAL_PASSWORD=change-this-immediately

# Allowed Vercel preview URL prefixes for CORS (comma-separated, no spaces)
# e.g. "narcotrack,narcotrack-staging" allows *.vercel.app URLs starting with those prefixes
ALLOWED_VERCEL_PREFIXES=narcotrack

# Environment
NODE_ENV=production
PORT=3001
